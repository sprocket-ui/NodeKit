{
  "name": "sprocketui",
  "private": true,
  "license": "MIT",
  "scripts": {
    "changeset": "changeset",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "dev": "turbo run dev",
    "dev:react": "turbo watch dev --filter=@sprocketui-react/*",
    "build": "turbo run //#build:tsdown",
    "build:tsdown": "tsdown",
    "test": "turbo run //#test:vitest",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "turbo run //#test:vitest -- --coverage",
    "test:chromium": "turbo run //#test:vitest -- --browser=chromium",
    "test:firefox": "turbo run //#test:vitest -- --browser=firefox",
    "test:webkit": "turbo run //#test:vitest -- --browser=webkit",
    "test:update": "turbo run //#test:vitest -- --update-snapshots",
    "postinstall": "lefthook install && playwright install",
    "clean": "rimraf --glob packages/**/node_modules packages/**/.turbo packages/**/dist packages/**/.dist node_modules .turbo dist .dist"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "@necto/constants": "^2.0.0",
      "vite": "npm:vite@beta"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.4",
    "@changesets/cli": "^2.29.2",
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@commitlint/types": "^20.0.0",
    "@playwright/test": "^1.59.1",
    "@types/ramda": "^0.31.1",
    "@types/tmp": "^0.2.6",
    "@vitest/browser": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "clean-publish": "^6.0.5",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "lefthook": "^2.0.0",
    "markdownlint-cli2": "^0.22.0",
    "playwright": "^1.59.1",
    "ramda": "^0.32.0",
    "rimraf": "^6.1.3",
    "terser": "^5.46.1",
    "tmp": "^0.2.5",
    "tsdown": "^0.12.9",
    "turbo": "^2.5.0",
    "vitest": "catalog:",
    "yaml-lint": "^1.7.0"
  }
}
