{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "//#build:tsdown": {
      "inputs": [
        "packages/**/src/**",
        "packages/**/tsdown.config.ts",
        "tsdown.config.ts"
      ],
      "outputs": ["packages/**/dist/**"]
    },
    "//#test:vitest": {
      "dependsOn": ["//#build:tsdown"],
      "inputs": [
        "packages/**/src/**",
        "packages/**/__tests__/**",
        "packages/**/vitest.config.ts",
        "packages/**/vitest.setup.ts",
        "vitest.config.ts"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:*": {
      "cache": false,
      "persistent": true
    }
  }
}
